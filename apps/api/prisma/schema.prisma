// Every tenant-owned model carries `universityId` (NF-05) and must be listed in
// src/tenancy/tenant-models.ts so the Prisma extension scopes it automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  driver
  office
  super_admin
}

enum Gender {
  male
  female
}

enum UserStatus {
  active
  suspended
}

model University {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  nameAr            String?  @map("name_ar")
  slug              String   @unique
  campusLat         Float    @map("campus_lat")
  campusLng         Float    @map("campus_lng")
  commissionPct     Decimal  @default(0) @map("commission_pct") @db.Decimal(5, 2)
  waitlistMinutes   Int      @default(30) @map("waitlist_minutes")
  integrationConfig Json     @default("{}") @map("integration_config")
  /// Service area as [[lat, lng], ...] polygon. Gathering points must lie inside it.
  coverage          Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users              User[]
  auditEvents        AuditEvent[]
  tiers              DistanceTier[]
  gatheringPoints    GatheringPoint[]
  waves              Wave[]
  driverRequirements DriverRequirementSet?
  travelTimes        TravelTime[]
  roster             RosterEntry[]
  drivers            DriverProfile[]
  driverDocuments    DriverDocument[]
  documentAccesses   DocumentAccess[]

  @@map("universities")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  /// Null only for role = super_admin (platform level).
  universityId String?     @map("university_id") @db.Uuid
  role         Role
  name         String
  email        String?     @unique
  phone        String?
  gender       Gender?
  passwordHash String?     @map("password_hash")
  status       UserStatus  @default(active)
  /// Students: university student number. Unique per university.
  studentId    String?     @map("student_id")
  nameAr       String?     @map("name_ar")
  /// Drivers sign in with this phone (OTP). Globally unique: a driver belongs to one university in v1.
  loginPhone   String?     @unique @map("login_phone")
  defaultPointId String?   @map("default_point_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  university   University?     @relation(fields: [universityId], references: [id])
  defaultPoint GatheringPoint? @relation(fields: [defaultPointId], references: [id])
  driver       DriverProfile?

  @@unique([universityId, studentId])
  @@index([universityId, role])
  @@map("users")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String?  @map("university_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String
  entity       String
  entityId     String?  @map("entity_id")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  university University? @relation(fields: [universityId], references: [id])

  @@index([universityId, createdAt])
  @@map("audit_events")
}

/// Price band by road distance to campus (PA-01). Tiers of one university are contiguous:
/// the first starts at 0 km, each next one starts where the previous ends, the last is open.
model DistanceTier {
  id                String   @id @default(uuid()) @db.Uuid
  universityId      String   @map("university_id") @db.Uuid
  name              String
  minKm             Float    @map("min_km")
  /// Null = no upper bound (last tier).
  maxKm             Float?   @map("max_km")
  /// Monthly subscription price in IQD.
  subscriptionPrice Int      @map("subscription_price")
  /// Pay-per-ride price in IQD.
  ridePrice         Int      @map("ride_price")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  university University       @relation(fields: [universityId], references: [id])
  points     GatheringPoint[]

  @@index([universityId, minKm])
  @@map("distance_tiers")
}

/// Fixed pickup point (SM-01). Tier is derived from road distance unless overridden.
model GatheringPoint {
  id             String   @id @default(uuid()) @db.Uuid
  universityId   String   @map("university_id") @db.Uuid
  name           String
  nameAr         String?  @map("name_ar")
  lat            Float
  lng            Float
  tierId         String   @map("tier_id") @db.Uuid
  tierOverridden Boolean  @default(false) @map("tier_overridden")
  /// Road distance / duration to campus from OSRM (null until computed).
  distanceKm     Float?   @map("distance_km")
  durationMin    Float?   @map("duration_min")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  university University   @relation(fields: [universityId], references: [id])
  tier       DistanceTier @relation(fields: [tierId], references: [id])
  students   User[]

  @@index([universityId, active])
  @@map("gathering_points")
}

enum WaveType {
  morning
  return
}

/// Morning arrival or return departure time, active on a set of weekdays (TO-05).
model Wave {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  type         WaveType
  /// Minutes after midnight (Asia/Baghdad). Morning: arrive-by time; return: departure time.
  minuteOfDay  Int      @map("minute_of_day")
  /// Bit mask, bit 0 = Sunday … bit 6 = Saturday.
  weekdays     Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@index([universityId, type])
  @@map("waves")
}

/// What the transport office requires from drivers and vehicles (TO-01).
model DriverRequirementSet {
  id                 String   @id @default(uuid()) @db.Uuid
  universityId       String   @unique @map("university_id") @db.Uuid
  /// [{ key, label, labelAr, required }]
  documents          Json     @default("[]")
  /// Allowed vehicle types, e.g. ["coaster", "minibus"].
  vehicleTypes       Json     @default("[]") @map("vehicle_types")
  minSeats           Int      @default(10) @map("min_seats")
  maxVehicleAgeYears Int      @default(15) @map("max_vehicle_age_years")
  updatedAt          DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@map("driver_requirement_sets")
}

/// Precomputed OSRM travel matrix (DS-01). Keys are gathering point ids or "campus".
model TravelTime {
  universityId String   @map("university_id") @db.Uuid
  fromKey      String   @map("from_key")
  toKey        String   @map("to_key")
  durationS    Int      @map("duration_s")
  distanceM    Int      @map("distance_m")
  computedAt   DateTime @default(now()) @map("computed_at")

  university University @relation(fields: [universityId], references: [id])

  @@id([universityId, fromKey, toKey])
  @@map("travel_times")
}

/// Students known to the university (manual identity provider): imported by the office.
/// The office issues a one-time activation code when the student comes to pay.
model RosterEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  universityId        String    @map("university_id") @db.Uuid
  studentId           String    @map("student_id")
  name                String
  nameAr              String?   @map("name_ar")
  gender              Gender
  activationCodeHash  String?   @map("activation_code_hash")
  activationExpiresAt DateTime? @map("activation_expires_at")
  activationAttempts  Int       @default(0) @map("activation_attempts")
  activatedAt         DateTime? @map("activated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, studentId])
  @@map("roster_entries")
}

enum DriverStatus {
  draft
  pending
  approved
  rejected
  suspended
}

/// Driver application + vehicle (DR-01) and its review state (TO-02).
model DriverProfile {
  userId       String       @id @map("user_id") @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  status       DriverStatus @default(draft)
  vehicleType  String?      @map("vehicle_type")
  plate        String?
  seats        Int?
  modelYear    Int?         @map("model_year")
  submittedAt  DateTime?    @map("submitted_at")
  reviewedAt   DateTime?    @map("reviewed_at")
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewNote   String?      @map("review_note")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id])
  university University       @relation(fields: [universityId], references: [id])
  documents  DriverDocument[]

  @@index([universityId, status])
  @@map("driver_profiles")
}

/// Uploaded document, stored privately (NF-13). One per requirement key; re-upload replaces it.
model DriverDocument {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  driverId     String   @map("driver_id") @db.Uuid
  key          String
  storageKey   String   @map("storage_key")
  mime         String
  sizeBytes    Int      @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  university University       @relation(fields: [universityId], references: [id])
  driver     DriverProfile    @relation(fields: [driverId], references: [userId])
  accesses   DocumentAccess[]

  @@unique([driverId, key])
  @@map("driver_documents")
}

/// Every issued document link is logged (NF-13).
model DocumentAccess {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  university University     @relation(fields: [universityId], references: [id])
  document   DriverDocument @relation(fields: [documentId], references: [id])

  @@index([universityId, documentId])
  @@map("document_accesses")
}

/// Phone one-time codes for driver sign-in. Not tenant-scoped (the university is chosen after).
model OtpCode {
  phone     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}
