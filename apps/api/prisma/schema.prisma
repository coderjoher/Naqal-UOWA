// Every tenant-owned model carries `universityId` (NF-05) and must be listed in
// src/tenancy/tenant-models.ts so the Prisma extension scopes it automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  driver
  office
  super_admin
}

enum Gender {
  male
  female
}

enum UserStatus {
  active
  suspended
}

model University {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  nameAr            String?  @map("name_ar")
  slug              String   @unique
  campusLat         Float    @map("campus_lat")
  campusLng         Float    @map("campus_lng")
  commissionPct     Decimal  @default(0) @map("commission_pct") @db.Decimal(5, 2)
  waitlistMinutes   Int      @default(30) @map("waitlist_minutes")
  /// SM-04: how long a bus waits at a stop for missing students.
  noShowWaitMinutes Int      @default(3) @map("no_show_wait_minutes")
  integrationConfig Json     @default("{}") @map("integration_config")
  /// Service area as [[lat, lng], ...] polygon. Gathering points must lie inside it.
  coverage          Json     @default("[]")
  /// Where and when students pay (shown in the student app), e.g. "Building B, room 12, 9–1".
  officeNote        String?  @map("office_note")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users              User[]
  auditEvents        AuditEvent[]
  tiers              DistanceTier[]
  gatheringPoints    GatheringPoint[]
  waves              Wave[]
  driverRequirements DriverRequirementSet?
  travelTimes        TravelTime[]
  roster             RosterEntry[]
  drivers            DriverProfile[]
  driverDocuments    DriverDocument[]
  documentAccesses   DocumentAccess[]
  payments           Payment[]
  subscriptions      Subscription[]
  receiptCounter     ReceiptCounter?
  availability       DriverAvailability[]
  rideRequests       RideRequest[]
  runs               Run[]
  runStops           RunStop[]
  wavePlans          WavePlan[]
  notifications      Notification[]
  runEvents          RunEvent[]
  runPositions       RunPosition[]
  deviceTokens       DeviceToken[]
  settlements        Settlement[]
  settlementLines    SettlementLine[]

  @@map("universities")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  /// Null only for role = super_admin (platform level).
  universityId   String?    @map("university_id") @db.Uuid
  role           Role
  name           String
  email          String?    @unique
  phone          String?
  gender         Gender?
  passwordHash   String?    @map("password_hash")
  status         UserStatus @default(active)
  /// Students: university student number. Unique per university.
  studentId      String?    @map("student_id")
  nameAr         String?    @map("name_ar")
  /// Drivers sign in with this phone (OTP). Globally unique: a driver belongs to one university in v1.
  loginPhone     String?    @unique @map("login_phone")
  defaultPointId String?    @map("default_point_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  university      University?          @relation(fields: [universityId], references: [id])
  defaultPoint    GatheringPoint?      @relation(fields: [defaultPointId], references: [id])
  driver          DriverProfile?
  subscriptions   Subscription[]
  payments        Payment[]            @relation("PaymentStudent")
  availability    DriverAvailability[] @relation("DriverAvailability")
  rideRequests    RideRequest[]        @relation("RideRequests")
  runs            Run[]                @relation("DriverRuns")
  notifications   Notification[]       @relation("Notifications")
  deviceTokens    DeviceToken[]        @relation("DeviceTokens")
  settlementLines SettlementLine[]     @relation("SettlementLines")

  @@unique([universityId, studentId])
  @@index([universityId, role])
  @@map("users")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String?  @map("university_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String
  entity       String
  entityId     String?  @map("entity_id")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  university University? @relation(fields: [universityId], references: [id])

  @@index([universityId, createdAt])
  @@map("audit_events")
}

/// Price band by road distance to campus (PA-01). Tiers of one university are contiguous:
/// the first starts at 0 km, each next one starts where the previous ends, the last is open.
model DistanceTier {
  id                String   @id @default(uuid()) @db.Uuid
  universityId      String   @map("university_id") @db.Uuid
  name              String
  minKm             Float    @map("min_km")
  /// Null = no upper bound (last tier).
  maxKm             Float?   @map("max_km")
  /// Monthly subscription price in IQD.
  subscriptionPrice Int      @map("subscription_price")
  /// Pay-per-ride price in IQD.
  ridePrice         Int      @map("ride_price")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  university University       @relation(fields: [universityId], references: [id])
  points     GatheringPoint[]

  @@index([universityId, minKm])
  @@map("distance_tiers")
}

/// Fixed pickup point (SM-01). Tier is derived from road distance unless overridden.
model GatheringPoint {
  id             String   @id @default(uuid()) @db.Uuid
  universityId   String   @map("university_id") @db.Uuid
  name           String
  nameAr         String?  @map("name_ar")
  lat            Float
  lng            Float
  tierId         String   @map("tier_id") @db.Uuid
  tierOverridden Boolean  @default(false) @map("tier_overridden")
  /// Road distance / duration to campus from OSRM (null until computed).
  distanceKm     Float?   @map("distance_km")
  durationMin    Float?   @map("duration_min")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  university University    @relation(fields: [universityId], references: [id])
  tier       DistanceTier  @relation(fields: [tierId], references: [id])
  students   User[]
  requests   RideRequest[]
  stops      RunStop[]

  @@index([universityId, active])
  @@map("gathering_points")
}

enum WaveType {
  morning
  return
}

/// Morning arrival or return departure time, active on a set of weekdays (TO-05).
model Wave {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  type         WaveType
  /// Minutes after midnight (Asia/Baghdad). Morning: arrive-by time; return: departure time.
  minuteOfDay  Int      @map("minute_of_day")
  /// Bit mask, bit 0 = Sunday … bit 6 = Saturday.
  weekdays     Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university   University           @relation(fields: [universityId], references: [id])
  availability DriverAvailability[]
  requests     RideRequest[]
  runs         Run[]
  plans        WavePlan[]

  @@index([universityId, type])
  @@map("waves")
}

/// What the transport office requires from drivers and vehicles (TO-01).
model DriverRequirementSet {
  id                 String   @id @default(uuid()) @db.Uuid
  universityId       String   @unique @map("university_id") @db.Uuid
  /// [{ key, label, labelAr, required }]
  documents          Json     @default("[]")
  /// Allowed vehicle types, e.g. ["coaster", "minibus"].
  vehicleTypes       Json     @default("[]") @map("vehicle_types")
  minSeats           Int      @default(10) @map("min_seats")
  maxVehicleAgeYears Int      @default(15) @map("max_vehicle_age_years")
  updatedAt          DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@map("driver_requirement_sets")
}

/// Precomputed OSRM travel matrix (DS-01). Keys are gathering point ids or "campus".
model TravelTime {
  universityId String   @map("university_id") @db.Uuid
  fromKey      String   @map("from_key")
  toKey        String   @map("to_key")
  durationS    Int      @map("duration_s")
  distanceM    Int      @map("distance_m")
  computedAt   DateTime @default(now()) @map("computed_at")

  university University @relation(fields: [universityId], references: [id])

  @@id([universityId, fromKey, toKey])
  @@map("travel_times")
}

/// Students known to the university (manual identity provider): imported by the office.
/// The office issues a one-time activation code when the student comes to pay.
model RosterEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  universityId        String    @map("university_id") @db.Uuid
  studentId           String    @map("student_id")
  name                String
  nameAr              String?   @map("name_ar")
  gender              Gender
  activationCodeHash  String?   @map("activation_code_hash")
  activationExpiresAt DateTime? @map("activation_expires_at")
  activationAttempts  Int       @default(0) @map("activation_attempts")
  activatedAt         DateTime? @map("activated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, studentId])
  @@map("roster_entries")
}

enum DriverStatus {
  draft
  pending
  approved
  rejected
  suspended
}

/// Driver application + vehicle (DR-01) and its review state (TO-02).
model DriverProfile {
  userId       String       @id @map("user_id") @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  status       DriverStatus @default(draft)
  vehicleType  String?      @map("vehicle_type")
  plate        String?
  seats        Int?
  modelYear    Int?         @map("model_year")
  submittedAt  DateTime?    @map("submitted_at")
  reviewedAt   DateTime?    @map("reviewed_at")
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewNote   String?      @map("review_note")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id])
  university University       @relation(fields: [universityId], references: [id])
  documents  DriverDocument[]

  @@index([universityId, status])
  @@map("driver_profiles")
}

/// Uploaded document, stored privately (NF-13). One per requirement key; re-upload replaces it.
model DriverDocument {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  driverId     String   @map("driver_id") @db.Uuid
  key          String
  storageKey   String   @map("storage_key")
  mime         String
  sizeBytes    Int      @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  university University       @relation(fields: [universityId], references: [id])
  driver     DriverProfile    @relation(fields: [driverId], references: [userId])
  accesses   DocumentAccess[]

  @@unique([driverId, key])
  @@map("driver_documents")
}

/// Every issued document link is logged (NF-13).
model DocumentAccess {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  university University     @relation(fields: [universityId], references: [id])
  document   DriverDocument @relation(fields: [documentId], references: [id])

  @@index([universityId, documentId])
  @@map("document_accesses")
}

/// Phone one-time codes for driver sign-in. Not tenant-scoped (the university is chosen after).
model OtpCode {
  phone     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

enum PaymentType {
  subscription
  cash_fare
  tier_difference
}

/// How the money was collected. Electronic methods plug in later without schema changes (PA-04).
enum PaymentMethod {
  cash_office
  cash_driver
  zaincash
  qi
}

/// Immutable money record (NF-14): UPDATE and DELETE are rejected by a database trigger.
/// Corrections are new rows with `reversesPaymentId` and a negative amount.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  universityId      String        @map("university_id") @db.Uuid
  type              PaymentType
  method            PaymentMethod
  /// IQD, whole dinars. Negative for reversals.
  amount            Int
  /// Sequential, gap-free per university.
  receiptNo         Int           @map("receipt_no")
  studentId         String?       @map("student_id") @db.Uuid
  collectedById     String        @map("collected_by_id") @db.Uuid
  externalRef       String?       @map("external_ref")
  reversesPaymentId String?       @unique @map("reverses_payment_id") @db.Uuid
  /// Cash fares (DR-07): the run and ride they were collected on; one fare per ride.
  runId             String?       @map("run_id") @db.Uuid
  rideRequestId     String?       @unique @map("ride_request_id") @db.Uuid
  /// Client-generated key so a retried request never records a second payment.
  idempotencyKey    String?       @unique @map("idempotency_key")
  note              String?
  createdAt         DateTime      @default(now()) @map("created_at")

  university   University    @relation(fields: [universityId], references: [id])
  student      User?         @relation("PaymentStudent", fields: [studentId], references: [id])
  reverses     Payment?      @relation("Reversal", fields: [reversesPaymentId], references: [id])
  reversedBy   Payment?      @relation("Reversal")
  run          Run?          @relation(fields: [runId], references: [id])
  subscription Subscription?

  @@unique([universityId, receiptNo])
  @@index([universityId, createdAt])
  @@map("payments")
}

enum SubscriptionStatus {
  active
  cancelled
}

/// Monthly subscription (ST-03, TO-06). Period follows SubscriptionPeriodPolicy (Q4: calendar month).
model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  universityId String             @map("university_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  tierId       String             @map("tier_id") @db.Uuid
  pointId      String             @map("point_id") @db.Uuid
  /// First month covered, "YYYY-MM".
  month        String
  periodStart  DateTime           @map("period_start") @db.Date
  periodEnd    DateTime           @map("period_end") @db.Date
  price        Int
  status       SubscriptionStatus @default(active)
  paymentId    String             @unique @map("payment_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  payment    Payment    @relation(fields: [paymentId], references: [id])

  @@index([universityId, month])
  @@index([studentId, periodEnd])
  @@map("subscriptions")
}

/// Last receipt number issued per university (incremented atomically with each payment).
model ReceiptCounter {
  universityId String @id @map("university_id") @db.Uuid
  last         Int    @default(0)

  university University @relation(fields: [universityId], references: [id])

  @@map("receipt_counters")
}

// ── P4: ride requests and dispatch ────────────────────────────────────────────

/// DR-02: a driver offers to run a wave on a date.
model DriverAvailability {
  universityId String   @map("university_id") @db.Uuid
  driverId     String   @map("driver_id") @db.Uuid
  date         DateTime @db.Date
  waveId       String   @map("wave_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id])
  driver     User       @relation("DriverAvailability", fields: [driverId], references: [id])
  wave       Wave       @relation(fields: [waveId], references: [id])

  @@id([driverId, date, waveId])
  @@index([universityId, date, waveId])
  @@map("driver_availability")
}

enum RideStatus {
  open
  assigned
  waitlisted
  cancelled
  done
  /// SM-04: the bus waited the configured time and the student did not come. No penalty.
  no_show
}

/// ST-04: a request for one wave on one date. At most one live request per student, wave and date.
model RideRequest {
  id              String     @id @default(uuid()) @db.Uuid
  universityId    String     @map("university_id") @db.Uuid
  studentId       String     @map("student_id") @db.Uuid
  waveId          String     @map("wave_id") @db.Uuid
  date            DateTime   @db.Date
  pointId         String     @map("point_id") @db.Uuid
  tierId          String     @map("tier_id") @db.Uuid
  gender          Gender
  /// SM-03: had an active subscription for the date when requesting.
  subscriber      Boolean
  /// Cash to the driver for this ride (PA-02/PA-03): ride price, tier difference, or 0.
  fare            Int
  status          RideStatus @default(open)
  runId           String?    @map("run_id") @db.Uuid
  waitlistedUntil DateTime?  @map("waitlisted_until")
  /// student | expired | office
  cancelReason    String?    @map("cancel_reason")
  boardedAt       DateTime?  @map("boarded_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  university University     @relation(fields: [universityId], references: [id])
  student    User           @relation("RideRequests", fields: [studentId], references: [id])
  wave       Wave           @relation(fields: [waveId], references: [id])
  point      GatheringPoint @relation(fields: [pointId], references: [id])
  run        Run?           @relation(fields: [runId], references: [id])

  @@index([universityId, date, waveId, status])
  @@index([studentId, date])
  @@map("ride_requests")
}

enum RunStatus {
  planned
  started
  at_stop
  done
  cancelled
}

/// DS-02: one bus doing one wave on one date.
model Run {
  id            String    @id @default(uuid()) @db.Uuid
  universityId  String    @map("university_id") @db.Uuid
  driverId      String    @map("driver_id") @db.Uuid
  waveId        String    @map("wave_id") @db.Uuid
  date          DateTime  @db.Date
  gender        Gender
  /// DS-06: tier of the farthest stop (Q3 default rule), kept so settlement can be recomputed.
  tierId        String    @map("tier_id") @db.Uuid
  capacity      Int
  status        RunStatus @default(planned)
  startedAt     DateTime? @map("started_at")
  endedAt       DateTime? @map("ended_at")
  /// SE-02: result of the GPS check when the run ended (null until checked).
  gpsVerified   Boolean?  @map("gps_verified")
  /// NF-15: anomaly flags, e.g. ["missed_stop:2", "too_fast"].
  gpsFlags      Json      @default("[]") @map("gps_flags")
  /// Office review of a flagged run: true counts it, false excludes it, null follows the GPS check.
  officeVerdict Boolean?  @map("office_verdict")
  officeNote    String?   @map("office_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  university University    @relation(fields: [universityId], references: [id])
  driver     User          @relation("DriverRuns", fields: [driverId], references: [id])
  wave       Wave          @relation(fields: [waveId], references: [id])
  stops      RunStop[]
  requests   RideRequest[]
  events     RunEvent[]
  positions  RunPosition[]
  payments   Payment[]

  @@unique([driverId, waveId, date])
  @@index([universityId, date, waveId])
  @@map("runs")
}

model RunStop {
  id           String    @id @default(uuid()) @db.Uuid
  universityId String    @map("university_id") @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  seq          Int
  pointId      String    @map("point_id") @db.Uuid
  /// Planned pickup (morning) or drop-off (return).
  eta          DateTime
  arrivedAt    DateTime? @map("arrived_at")
  servedAt     DateTime? @map("served_at")

  university University     @relation(fields: [universityId], references: [id])
  run        Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  point      GatheringPoint @relation(fields: [pointId], references: [id])

  @@unique([runId, seq])
  @@map("run_stops")
}

/// Marks a wave on a date as planned; later requests go through insertion (DS-03).
model WavePlan {
  universityId String   @map("university_id") @db.Uuid
  waveId       String   @map("wave_id") @db.Uuid
  date         DateTime @db.Date
  plannedAt    DateTime @default(now()) @map("planned_at")

  university University @relation(fields: [universityId], references: [id])
  wave       Wave       @relation(fields: [waveId], references: [id])

  @@id([waveId, date])
  @@map("wave_plans")
}

/// Outbox of messages for a user (in-app now; push delivery in P5).
model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  universityId String    @map("university_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kind         String
  data         Json      @default("{}")
  /// ST-09: each event notifies once (e.g. "approaching:<requestId>").
  dedupeKey    String?   @unique @map("dedupe_key")
  pushedAt     DateTime? @map("pushed_at")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id])
  user       User       @relation("Notifications", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

// ── P5: runs, live tracking, notifications ───────────────────────────────────

/// Every driver action on a run, keyed by a client id so offline retries are applied once (NF-09).
model RunEvent {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  clientId     String   @map("client_id")
  type         String
  payload      Json     @default("{}")
  /// When it happened on the device (may be earlier than receipt when buffered offline).
  at           DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id])
  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, clientId])
  @@index([runId, at])
  @@map("run_events")
}

/// NF-01: one stored GPS point per run per minute (live points stay in Redis).
model RunPosition {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  lat          Float
  lng          Float
  speed        Float?
  heading      Float?
  at           DateTime

  university University @relation(fields: [universityId], references: [id])
  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@map("run_positions")
}

/// Firebase Cloud Messaging registration of one app install (ST-09).
model DeviceToken {
  id           String   @id @default(uuid()) @db.Uuid
  universityId String   @map("university_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  platform     String
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])
  user       User       @relation("DeviceTokens", fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

// ── P6: settlement ───────────────────────────────────────────────────────────

enum SettlementStatus {
  draft
  approved
}

/// TO-09: one month of driver payouts for a university. A draft can be recomputed; an approved
/// settlement is immutable (database trigger), like payments (NF-14). Money is whole IQD.
model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  universityId     String           @map("university_id") @db.Uuid
  /// "YYYY-MM"
  month            String
  status           SettlementStatus @default(draft)
  /// Commission c in basis points (10 % = 1000), frozen at computation time.
  commissionBp     Int              @map("commission_bp")
  /// [{ tierId, name, pool, runs, commission }]
  tiers            Json             @default("[]")
  totalPool        BigInt           @map("total_pool")
  totalPayout      BigInt           @map("total_payout")
  totalCommission  BigInt           @map("total_commission")
  totalCash        BigInt           @map("total_cash")
  /// Pools of tiers that had no verified run this month (not paid to anyone).
  unallocated      BigInt
  /// Σ pools − Σ payouts − commission − unallocated: dinars lost to flooring each payout.
  roundingResidual BigInt           @map("rounding_residual")
  /// Runs left out because they failed the GPS check (SE-02).
  excludedRuns     Int              @map("excluded_runs")
  computedAt       DateTime         @default(now()) @map("computed_at")
  approvedAt       DateTime?        @map("approved_at")
  approvedById     String?          @map("approved_by_id") @db.Uuid

  university University       @relation(fields: [universityId], references: [id])
  lines      SettlementLine[]

  @@unique([universityId, month])
  @@map("settlements")
}

model SettlementLine {
  id             String @id @default(uuid()) @db.Uuid
  universityId   String @map("university_id") @db.Uuid
  settlementId   String @map("settlement_id") @db.Uuid
  driverId       String @map("driver_id") @db.Uuid
  /// Verified runs counted, all tiers.
  runs           Int
  /// [{ tierId, runs, share }]
  tiers          Json   @default("[]")
  /// Cash fares the driver collected (and kept) this month.
  cash           BigInt
  /// c × cash, taken out of the payout.
  cashCommission BigInt @map("cash_commission")
  /// What the office pays the driver (negative: the driver owes the office).
  payout         BigInt

  university University @relation(fields: [universityId], references: [id])
  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  driver     User       @relation("SettlementLines", fields: [driverId], references: [id])

  @@unique([settlementId, driverId])
  @@map("settlement_lines")
}
