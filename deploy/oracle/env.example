# Copy to the repository root as .env:   cp deploy/oracle/env.example .env
# Generate the two secrets with:          openssl rand -hex 32

# Three free DuckDNS names pointing at the server's public IP (docs/DEPLOY-ORACLE.md, step 4).
DASHBOARD_DOMAIN=naql-office.duckdns.org
STUDENT_DOMAIN=naql-app.duckdns.org
DRIVER_DOMAIN=naql-driver.duckdns.org
ACME_EMAIL=you@example.com

JWT_SECRET=
DB_PASSWORD=

# true = demo data and driver sign-in codes shown on screen (no SMS). false for real use.
DEMO=true
# One API process per core (the free Ampere server has 4).
API_WORKERS=3

# Map tiles: empty = OpenStreetMap (fine for testing; docs/OPERATIONS.md §8).
VITE_MAP_TILES=
VITE_MAP_ATTRIBUTION=
MAP_TILES=
MAP_ATTRIBUTION=
