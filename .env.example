# Copy to .env next to docker-compose.yml and fill in for production (see docs/OPERATIONS.md).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
DEMO=false
API_WORKERS=2
METRICS_TOKEN=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# HTTPS (docker compose --profile https up -d)
ACME_EMAIL=
DASHBOARD_DOMAIN=
STUDENT_DOMAIN=
DRIVER_DOMAIN=
# Backups (docker compose --profile backup up -d)
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
# Map tiles (docs/OPERATIONS.md §8); empty = OpenStreetMap, set a keyed provider for full launch
VITE_MAP_TILES=
VITE_MAP_ATTRIBUTION=
MAP_TILES=
MAP_ATTRIBUTION=
